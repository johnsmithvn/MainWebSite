# =============================================================================
# react-app/.env — cấu hình Vite dev server và bước build React app
# -----------------------------------------------------------------------------
# Copy file này thành react-app/.env. Mọi biến đều TUỲ CHỌN: để trống hoặc
# comment lại thì dùng mặc định. Bản production do backend phục vụ, nên file
# này không ảnh hưởng tới server production. Chi tiết: readme.md, mục 3.2.
#
# ⚠️ KHÔNG đặt NODE_ENV trong file này: Vite dùng nó cả khi build, và
#    NODE_ENV=development làm `vite build` ra bản development (nặng, chậm).
# =============================================================================


# Đường dẫn gốc của app (chỉ đổi khi deploy dưới thư mục con)
VITE_BASE=/

# Dung lượng trống tối thiểu (MB) phải còn lại sau khi tải chapter offline.
# Mặc định: 50 (máy tính) / 25 (điện thoại)
# VITE_MIN_STORAGE_SPACE=50


# -----------------------------------------------------------------------------
# Truy cập dev server (npm run dev, cổng 3001) từ thiết bị khác
# -----------------------------------------------------------------------------
# localhost, MỌI địa chỉ IP và mọi domain *.ts.net luôn được phép.
# Chỉ cần khai báo khi mở bằng domain khác (cách nhau dấu phẩy).
# VITE_ALLOWED_HOSTS=media.home.lan

# Hot reload khi mở dev server qua domain Tailscale (host này cũng được tự
# thêm vào danh sách được phép ở trên)
# VITE_HMR_HOST=your-device-name.tail12345.ts.net
# VITE_HMR_PORT=3001

# Dev server chạy HTTPS.
# ⚠️ vite.config.js chưa cấu hình chứng chỉ nên bật lên có thể không vào được
#    (docs/ISSUES-REPORT.md, mục C4)
# VITE_ENABLE_HTTPS=true


# -----------------------------------------------------------------------------
# Debug
# -----------------------------------------------------------------------------
# VITE_DISABLE_HMR=true
# VITE_DISABLE_STRICT_MODE=true
