# =============================================================================
# backend/.env — cấu hình server MainWebSite
# -----------------------------------------------------------------------------
# Copy file này thành backend/.env rồi sửa giá trị. Sửa xong phải khởi động
# lại server. Giải thích chi tiết: readme.md, mục "3. Cấu hình".
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SERVER
# -----------------------------------------------------------------------------

# Cổng backend. Đổi cổng thì sửa cả API_TARGET trong react-app/vite.config.js
PORT=3000

# true = chạy HTTPS bằng ssl/certificate.pem + ssl/private-key.pem (ở gốc repo).
# Bật mà thiếu chứng chỉ thì server tự chạy HTTP và in hướng dẫn ra console.
ENABLE_HTTPS=false

# NODE_ENV do script npm đặt sẵn (npm run dev → development, npm run prod →
# production). Chỉ cần khi chạy thẳng `node server.js`. Thường để nguyên.
# NODE_ENV=development


# -----------------------------------------------------------------------------
# 2. NGUỒN MEDIA
# -----------------------------------------------------------------------------
# Mỗi dòng là một "source key". Tiền tố quyết định loại nội dung:
#   ROOT_   manga  (mỗi thư mục con trực tiếp là một "root" để chọn)
#   V_      phim
#   M_      nhạc
#   MEDIA_  thư viện ảnh/video (media gallery)
# Phần sau tiền tố đặt tuỳ ý (VD: ROOT_TRUYEN, V_ANIME), khai báo bao nhiêu
# nguồn cũng được. Đường dẫn Windows nên dùng dấu "/".
# Key chỉ được nạp nếu thư mục TỒN TẠI lúc server khởi động.
# Mỗi key có một database riêng: backend/data/<KEY>.db

ROOT_MANGA=E:/File/Manga
V_MOVIE=E:/File/Video
M_MUSIC=E:/File/Music
MEDIA_PHOTOS=E:/File/Photos


# -----------------------------------------------------------------------------
# 3. AI ĐƯỢC TRUY CẬP (whitelist)
# -----------------------------------------------------------------------------
# IP có trong ALLOWED_IPS được cho qua. IP khác: server tra ngược DNS
# (Tailscale MagicDNS) và so KHỚP CHÍNH XÁC với ALLOWED_HOSTNAMES, không khớp
# thì trả 403.
#   - Bắt buộc giữ 127.0.0.1 (chính máy chủ và Vite dev proxy).
#   - Không biết điền hostname gì: truy cập thử từ thiết bị đó, console server
#     in "❌ Truy cập bị chặn từ hostname: <tên>" → copy <tên> vào đây.

ALLOWED_IPS=127.0.0.1,192.168.1.10
ALLOWED_HOSTNAMES=ten-thiet-bi-1,ten-thiet-bi-2


# -----------------------------------------------------------------------------
# 4. MẬT KHẨU CHO NGUỒN RIÊNG TƯ
# -----------------------------------------------------------------------------
# Các key trong SECURITY phải đăng nhập mới xem được (để trống = tất cả công khai).
# Đăng nhập xong, trình duyệt nhận một token (không phải mật khẩu). Token được tính
# từ mật khẩu + file bí mật backend/data/.auth-secret (tự tạo). Đổi mật khẩu hoặc
# xoá file đó thì mọi thiết bị phải đăng nhập lại.

SECURITY=V_MOVIE,ROOT_MANGA
SECURITY_PASSWORD=doi_mat_khau_nay


# -----------------------------------------------------------------------------
# 5. CORS — địa chỉ trang web được phép gọi API
# -----------------------------------------------------------------------------
# Định dạng: host:cổng1,cổng2|giao_thức1,giao_thức2  (nhiều host cách nhau ";")
# Luôn được chấp nhận, không cần khai báo: domain *.ts.net và chính địa chỉ IP
# đang mở app (VD http://192.168.1.10:3000); ở dev mode thêm mọi IP nội bộ.
# Chỉ cần thêm khi mở app bằng một domain khác, VD:
# CORS_DEV_CONFIG=localhost:3000,3001|http;127.0.0.1:3000,3001|http;media.home.lan:3000|http

CORS_DEV_CONFIG=localhost:3000,3001|http;127.0.0.1:3000,3001|http


# -----------------------------------------------------------------------------
# 6. TAILSCALE
# -----------------------------------------------------------------------------
# Domain máy chủ = <TAILSCALE_DEVICE>.<TAILSCALE_TAILNET>.ts.net
# (xem bằng `tailscale status` hoặc trang quản trị Tailscale).
# Dùng để in URL lúc khởi động và tạo danh sách CORS cho domain này.

TAILSCALE_DEVICE=your-device-name
TAILSCALE_TAILNET=tail12345
TAILSCALE_PORTS=3000,3001
TAILSCALE_PROTOCOLS=http,https
